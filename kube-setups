step 1:
minikube start
mount volumes:
minikube mount "C:\Softwares\projects\online-shop-backend\images:/mnt/portshop-images" -> shop images
minikube mount "C:\Softwares\projects\db_volume:/mnt/portshop-database" -> db volumes

!!! because of p9 file system used by minikube, now need to copy database and images into minikube!!!
sudo tar -C /mnt/portshop-images -cf - . | sudo tar -C /var/lib/portshop-images -xf -
sudo tar -C /mnt/portshop-database -cf - . | sudo tar -C /var/lib/portshop-database -xf -

